generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  isPremium            Boolean   @default(false)
  premiumUntil         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  quizAttempts QuizAttempt[]
}

model Question {
  id          String   @id @default(cuid())
  category    String
  prompt      String
  optionA     String
  optionB     String
  optionC     String
  optionD     String
  answer      String
  explanation String?
  createdAt   DateTime @default(now())

  attemptQuestions QuizAttemptQuestion[]
}

model QuizAttempt {
  id              String   @id @default(cuid())
  userId          String?
  email           String?
  category        String
  score           Int      @default(0)
  total           Int      @default(10)
  timed           Boolean  @default(false)
  durationSeconds Int?
  createdAt       DateTime @default(now())

  user      User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  questions QuizAttemptQuestion[]
}

model QuizAttemptQuestion {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  chosen     String?
  isCorrect  Boolean?

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model VerseCache {
  id          String   @id @default(cuid())
  dayKey      String
  translation String
  reference   String
  text        String
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dayKey, translation])
  @@index([dayKey])
}

model AiCache {
  id          String   @id @default(cuid())
  cacheKey    String   @unique
  kind        String
  translation String
  reference   String?
  inputJson   String
  outputText  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@index([createdAt])
}
