// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  displayName          String?
  passwordHash         String?
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?        @unique
  isPremium            Boolean        @default(false)
  premiumUntil         DateTime?
  referredBy           String?
  emailOptIn           Boolean        @default(false)
  emailTime            String         @default("07:00")
  emailTimezone        String         @default("UTC")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  quizAttempts         QuizAttempt[]
  subscriptions        Subscription[]
  savedItems           SavedItem[]
  streak               UserStreak?

  @@index([referredBy])
}

model UserStreak {
  id               String   @id @default(cuid())
  userId           String   @unique
  currentStreak    Int      @default(1)
  longestStreak    Int      @default(1)
  lastActivityDate String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  stripeSubscriptionId String?   @unique
  stripeCustomerId     String?
  stripeSessionId      String?   @unique
  status               String
  priceId              String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SavedItem {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String?
  content    String
  reference  String?
  metaJson   String?
  isArchived Boolean   @default(false)
  answeredAt DateTime?
  answerNote String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isArchived, createdAt])
  @@index([type])
}

model AiUsage {
  id        String   @id @default(cuid())
  dayKey    String
  userKey   String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayKey, userKey])
  @@index([dayKey])
}

model AiCache {
  id          String   @id @default(cuid())
  cacheKey    String   @unique
  kind        String
  translation String
  reference   String?
  inputJson   String
  outputText  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@index([createdAt])
}

model VerseCache {
  id          String   @id @default(cuid())
  dayKey      String
  translation String
  reference   String
  text        String
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dayKey, translation])
  @@index([dayKey])
}

model BiblePassageCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  bibleId   String
  passageId String
  json      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bibleId])
  @@index([createdAt])
}

model BibleSearchCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  bibleId   String
  query     String
  json      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bibleId])
  @@index([createdAt])
}

model Question {
  id               String                @id @default(cuid())
  category         String
  prompt           String
  optionA          String
  optionB          String
  optionC          String
  optionD          String
  answer           String
  explanation      String?
  createdAt        DateTime              @default(now())
  attemptQuestions QuizAttemptQuestion[]

  @@index([category])
}

model QuizAttempt {
  id              String                @id @default(cuid())
  userId          String?
  email           String?
  category        String
  score           Int                   @default(0)
  total           Int                   @default(10)
  timed           Boolean               @default(false)
  durationSeconds Int?
  createdAt       DateTime              @default(now())
  actorKey        String?
  shareId         String?               @unique
  sharedAt        DateTime?
  user            User?                 @relation(fields: [userId], references: [id])
  questions       QuizAttemptQuestion[]

  @@index([actorKey])
  @@index([category])
  @@index([createdAt])
  @@index([actorKey, category, createdAt])
  @@index([shareId])
}

model QuizAttemptQuestion {
  id         String      @id @default(cuid())
  attemptId  String
  questionId String
  chosen     String?
  isCorrect  Boolean?
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model QuizSeenQuestion {
  id         String   @id @default(cuid())
  actorKey   String
  category   String
  questionId String
  createdAt  DateTime @default(now())

  @@unique([actorKey, category, questionId])
  @@index([actorKey])
  @@index([category])
  @@index([actorKey, category, createdAt])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrayerRequest {
  id        String   @id @default(cuid())
  name      String?
  text      String
  prayCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}